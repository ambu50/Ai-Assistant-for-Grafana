{
  "name": "ai-assistant-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude 'external/**'",
    "package": "npm run build && python3 scripts/package_plugin.py",
    "test:package": "python3 -m unittest discover -s scripts -p 'test_*.py'"
  },
  "dependencies": {
    "@grafana/data": "12.4.13",
    "@grafana/llm": "1.0.9",
    "@grafana/runtime": "12.4.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.1.0",
    "remark-gfm": "4.0.1",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "copy-webpack-plugin": "12.0.2",
    "css-loader": "7.1.5",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "webpack": "5.112.0",
    "webpack-cli": "6.0.1"
  },
  "license": "Apache-2.0"
}
